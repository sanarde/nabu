project(
  'nabu',
  'c',
  version: '0.1.0',
  license: 'GPL-3.0-only',
  meson_version: '>=1.0',
  default_options: [
    'c_std=c17',
    'warning_level=3',
    'buildtype=debugoptimized',
  ],
)

add_project_arguments('-D_GNU_SOURCE', language: 'c')
add_project_arguments('-DNABU_VERSION="@0@"'.format(meson.project_version()), language: 'c')

subdir('core')
subdir('daemon')
subdir('data')
